<Window x:Class="CCC.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/CCC;component/Assets/cookie.ico"
        Title="CCC • IT Administrator"
        Width="600"
        Height="600"
        MinWidth="600"
        MinHeight="600"
        MaxWidth="600"
        MaxHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#000000"
        Foreground="{StaticResource TextBrush}">

    <Grid Margin="18"
          Background="#000000">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <DockPanel Grid.Row="0">

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="IT ADMINISTRATOR"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Privileged endpoint maintenance"
                           FontSize="10"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,3,0,0"/>

            </StackPanel>


            <TextBlock DockPanel.Dock="Right"
                       Text="CCC"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"/>

        </DockPanel>


        <!-- ===================================================== -->
        <!-- TOP NAVIGATION -->
        <!-- ===================================================== -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- REPAIR -->
            <Button Grid.Column="0"
                    Content="REPAIR CHROME"
                    Height="38"
                    Margin="0,0,8,0"/>


            <!-- APPS -->
            <Button Grid.Column="1"
                    Content="APPS"
                    Height="38"
                    Margin="0,0,8,0"
                    Click="Apps_Click"/>


            <!-- TOOLS -->
            <Button Grid.Column="2"
                    Content="TOOLS"
                    Height="38"
                    Margin="0,0,8,0"
                    Click="Tools_Click"/>


            <!-- CLOSE -->
            <Button Grid.Column="3"
                    Content="CLOSE"
                    Height="38"
                    Click="Close_Click"/>

        </Grid>


        <!-- ===================================================== -->
        <!-- CONTENT AREA -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="#000000"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Padding="18">

            <Grid x:Name="AdminContent">


                <!-- ================================================= -->
                <!-- REPAIR VIEW -->
                <!-- ================================================= -->

                <Grid x:Name="RepairView"
                      Visibility="Visible">

                    <StackPanel>

                        <TextBlock Text="Chrome Repair"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>


                        <TextBlock Text="Runs elevated and performs a destructive Chrome cleanup/reinstall."
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,8,0,18"/>


                        <Button Content="REPAIR CHROME"
                                Width="150"
                                Height="40"
                                HorizontalAlignment="Left"
                                Click="RepairChrome_Click"/>


                        <ProgressBar x:Name="RepairProgress"
                                     Height="4"
                                     Margin="0,22,0,0"
                                     IsIndeterminate="False"/>


                        <TextBlock x:Name="RepairStatus"
                                   Margin="0,9,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedBrush}"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- APPS VIEW -->
                <!-- ================================================= -->

                <Grid x:Name="AppsView"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <TextBlock Text="WinGet Application Deployment"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>


                    <ListView Grid.Row="1"
                              x:Name="AppsList"
                              Margin="0,14,0,0"
                              Background="#000000"
                              BorderThickness="0"
                              Foreground="{StaticResource TextBrush}">

                        <ListView.View>

                            <GridView>

                                <!-- APPLICATION -->
                                <GridViewColumn Header="Application"
                                                Width="185"
                                                DisplayMemberBinding="{Binding Name}"/>


                                <!-- WINGET ID -->
                                <GridViewColumn Header="WinGet ID"
                                                Width="180"
                                                DisplayMemberBinding="{Binding Id}"/>


                                <!-- ACTION -->
                                <GridViewColumn Header="Action"
                                                Width="85">

                                    <GridViewColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="INSTALL"
                                                    Click="InstallApp_Click"
                                                    Tag="{Binding}"
                                                    Padding="7,3"/>

                                        </DataTemplate>

                                    </GridViewColumn.CellTemplate>

                                </GridViewColumn>

                            </GridView>

                        </ListView.View>

                    </ListView>

                </Grid>


                <!-- ================================================= -->
                <!-- TOOLS VIEW -->
                <!-- ================================================= -->

                <Grid x:Name="ToolsView"
                      Visibility="Collapsed">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>


                    <!-- TITLE -->
                    <TextBlock Text="Troubleshooting Tools"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="White"/>


                    <!-- TOOL BUTTONS -->
                    <WrapPanel x:Name="ToolsPanel"
                               Grid.Row="1"
                               Margin="0,12,0,10"/>


                    <!-- CONSOLE -->
                    <TextBox x:Name="ConsoleOutput"
                             Grid.Row="2"
                             IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             TextWrapping="Wrap"
                             Background="#050505"
                             Foreground="#D7DAE0"
                             BorderBrush="{StaticResource BorderBrush}"
                             FontFamily="Consolas"/>


                    <!-- CONSOLE CONTROLS -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="CLEAR"
                                Width="70"
                                Height="25"
                                Click="ClearConsole_Click"
                                Margin="0,4,6,0"/>


                        <Button Content="COPY"
                                Width="70"
                                Height="25"
                                Click="CopyConsole_Click"
                                Margin="0,4,0,0"/>

                    </StackPanel>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>