<Window x:Class="CCC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/CCC;component/Assets/cookie.ico"
        Title="CCC • Clear Cookies Cache"
        Width="600" Height="600"
        MinWidth="600" MinHeight="600"
        MaxWidth="600" MaxHeight="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}">
    <Window.InputBindings>
        <KeyBinding Key="A" Modifiers="Ctrl+Shift" Command="{Binding OpenAdminCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="96"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#17181D">
            <StackPanel Margin="30,18,0,0">
                <TextBlock Text="CCC" FontSize="31" FontWeight="Light"/>
                <TextBlock Text="CLEAR COOKIES CACHE" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,-5,0,0"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Margin="0,28,20,0">
                <TextBlock Text="ENDPOINT MANAGEMENT" Foreground="{StaticResource AccentBrush}" FontSize="11" HorizontalAlignment="Right"/>
                <TextBlock Text="v4.7 WPF" Foreground="#8D93A0" FontSize="10" HorizontalAlignment="Right" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="20,3,20,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="265"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="55"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="SELF-SERVICE" FontSize="16" FontWeight="Medium"/>
                    <Border Width="35" Height="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    <TextBlock Grid.Row="1" Text="Clear browser cache and cookies for the current Windows user."
                               TextWrapping="Wrap" FontSize="11" Foreground="#AEB4C0" VerticalAlignment="Center"/>
                    <Button Grid.Row="2" x:Name="CleanButton" Content="CLEAN" Style="{StaticResource PrimaryButton}"
                            Click="CleanButton_Click" Margin="0,4,0,6"/>
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="Chrome + Edge" FontSize="11" Foreground="#AEB4C0"/>
                        <Border Height="1" Background="#383A43" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="74"/>
                        <RowDefinition Height="74"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BROWSER STATUS" FontSize="16" FontWeight="Medium"/>

                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CHROME" FontSize="11"/>
                                <TextBlock x:Name="ChromeVersionText" Text="Checking..." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Ellipse x:Name="ChromeDot" Width="6" Height="6" Fill="{StaticResource WarningBrush}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="ChromeStatusText" Text="CHECKING" FontSize="10" Foreground="{StaticResource WarningBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="TerminateChromeButton" Content="TERMINATE"
                                    Style="{StaticResource DangerButton}" Height="38" VerticalAlignment="Center"
                                    Click="TerminateChromeButton_Click"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource CardBrush}" Padding="13" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="EDGE" FontSize="11"/>
                            <TextBlock x:Name="EdgeVersionText" Text="Checking..." FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Ellipse x:Name="EdgeDot" Width="6" Height="6" Fill="{StaticResource DangerBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="EdgeStatusText" Text="CHECKING" FontSize="10" Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="20,0,20,0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="13,7">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/><ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="65"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ENDPOINT" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="PC: " Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ComputerNameText" FontSize="10"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="USER: " Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ComputerUserText" FontSize="10"/></StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal"><TextBlock Text="IP: " Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="ComputerIpText" FontSize="10"/><TextBlock x:Name="AdapterText" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="6,0,0,0"/></StackPanel>

                <TextBlock Grid.Row="1" Text="SYSTEM" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OsText" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="RamText" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Grid.Column="3" x:Name="UptimeText" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,0,20,14">
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="25"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ACTIVITY" FontSize="15" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Live operation log" FontSize="10" Foreground="#8F95A1" Margin="15,0,0,0" VerticalAlignment="Center"/>
                <Button Content="REFRESH STATUS" Margin="18,0,0,0" Height="24" Padding="8,2" Click="RefreshStatusButton_Click"/>
            </StackPanel>
            <Border Grid.Row="1" Background="#08090C" BorderBrush="#363943" BorderThickness="1">
                <TextBox x:Name="ActivityLog" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            </Border>
            <Grid Grid.Row="2">
                <ProgressBar x:Name="ProgressBar" Height="3" VerticalAlignment="Bottom" Minimum="0" Maximum="100"/>
                <TextBlock x:Name="StatusText" Text="Ready" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10" Foreground="{StaticResource SuccessBrush}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
